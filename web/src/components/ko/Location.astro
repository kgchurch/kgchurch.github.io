---
const mapSrc = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3233.4385401182462!2d139.97571977657879!3d35.86276857252917!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60189d65a5005f4b%3A0x1b482973c4f68ae9!2z7Lm07Iuc7JmA7JiB6rSR6rWQ7ZqMKOafj-aghOWFieaVmeS8mik!5e0!3m2!1sko!2sjp!4v1738153543995!5m2!1sko!2sjp";
---

<section class="mx-auto max-w-4xl px-5 py-16 md:px-10 md:py-24">
  <div class="mb-12 text-center">
    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-secondary">Location</p>
    <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">오시는길</h1>
  </div>

  <div class="mb-6 rounded-2xl border border-base-300 bg-base-100 p-6 md:p-8">
    <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-secondary">주소</p>
    <p class="text-lg font-medium md:text-xl">〒277-0005 千葉県柏市柏７丁目５−５７ ソフィアビル３F</p>
  </div>

  <div class="overflow-hidden rounded-2xl border border-base-300">
    <iframe
      src={mapSrc}
      class="h-80 w-full md:h-[450px]"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</section>
