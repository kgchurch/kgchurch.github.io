---
const tables = [
  {
    heading: "주일 예배시간",
    rows: [
      { time: "주일 10:00", name: "1부 예배", lang: "일본어", interp: "없음" },
      { time: "주일 12:00(정오)", name: "2부 예배", lang: "한국어", interp: "일본어" },
      { time: "주일 10:30", name: "주일학교", lang: "한국어 또는 일본어", interp: "없음" },
    ],
  },
  {
    heading: "예배시간",
    rows: [
      { time: "월 ~ 금요일 06:00", name: "새벽 예배", lang: "한국어", interp: "없음" },
      { time: "수요일 13:00", name: "수요 예배", lang: "한국어", interp: "없음" },
      { time: "금요일 20:30", name: "금요 성령집회", lang: "한국어", interp: "없음" },
    ],
  },
];
---

<section class="mx-auto max-w-4xl px-5 py-16 md:px-10 md:py-24">
  <div class="mb-12 text-center">
    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-secondary">Service Times</p>
    <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">예배 안내</h1>
  </div>

  <div class="space-y-12">
    {tables.map((t) => (
      <div>
        <h2 class="mb-4 text-xl font-semibold text-primary md:text-2xl">{t.heading}</h2>
        <div class="overflow-x-auto rounded-2xl border border-base-300">
          <table class="table">
            <thead class="bg-base-200 text-base-content/70">
              <tr>
                <th class="text-sm font-semibold">시간</th>
                <th class="text-sm font-semibold">예배</th>
                <th class="text-sm font-semibold">언어</th>
                <th class="text-sm font-semibold">통역</th>
              </tr>
            </thead>
            <tbody>
              {t.rows.map((r) => (
                <tr class="hover:bg-base-200/50">
                  <th class="whitespace-nowrap font-semibold text-primary">{r.time}</th>
                  <td>{r.name}</td>
                  <td>{r.lang}</td>
                  <td>{r.interp}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </div>
</section>
