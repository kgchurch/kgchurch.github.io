---
import { getRelativeLocaleUrl } from 'astro:i18n';

const koUrl = getRelativeLocaleUrl("ko", "");
const jaUrl = getRelativeLocaleUrl("ja", "");

const links = [
  { to: "/service-times", label: "예배시간" },
  { to: "/location", label: "오시는길" },
];
---

<header class="sticky top-0 z-50 border-b border-base-300 bg-base-100/85 backdrop-blur-md">
  <div class="navbar mx-auto min-h-[72px] max-w-7xl px-4 md:px-10">
    <div class="flex-1">
      <div class="dropdown lg:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-square" aria-label="메뉴">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </div>
        <ul
          tabindex="-1"
          class="menu dropdown-content z-1 mt-3 w-64 gap-1 rounded-box border border-base-300 bg-base-100 p-3 text-base shadow-lg">
          {links.map((link) => (
            <li><a href={link.to}>{link.label}</a></li>
          ))}
          <li><a href={jaUrl} class="text-base-content/60">日本語</a></li>
        </ul>
      </div>

      <a href={koUrl} class="flex items-center px-2">
        <span class="text-lg font-semibold tracking-tight">카시와영광교회</span>
      </a>
    </div>

    <nav class="hidden items-center gap-2 lg:flex">
      <ul class="menu menu-horizontal gap-1 text-[15px] font-medium">
        {links.map((link) => (
          <li><a href={link.to}>{link.label}</a></li>
        ))}
      </ul>
      <a href={jaUrl} class="btn btn-outline btn-sm ml-1 rounded-full font-medium">日本語</a>
    </nav>
  </div>
</header>
