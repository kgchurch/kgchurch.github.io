---
const tables = [
  {
    heading: "主日礼拝時間",
    rows: [
      { time: "主日 10:00", name: "第１礼拝", lang: "日本語", interp: "なし" },
      { time: "主日 12:00(正午)", name: "第２礼拝", lang: "韓国語", interp: "日本語" },
      { time: "主日 10:30", name: "教会学校", lang: "韓国語 または 日本語", interp: "なし" },
    ],
  },
  {
    heading: "礼拝時間",
    rows: [
      { time: "月 ~ 金曜日 06:00", name: "早天祈り会", lang: "韓国語", interp: "なし" },
      { time: "水曜日 13:00", name: "水曜礼拝", lang: "韓国語", interp: "日本語" },
      { time: "金曜日 20:30", name: "金曜聖霊集会", lang: "韓国語", interp: "なし" },
    ],
  },
];
---

<section class="mx-auto max-w-4xl px-5 py-16 md:px-10 md:py-24">
  <div class="mb-12 text-center">
    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-secondary">Service Times</p>
    <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">礼拝のご案内</h1>
  </div>

  <div class="space-y-12">
    {tables.map((t) => (
      <div>
        <h2 class="mb-4 text-xl font-semibold text-primary md:text-2xl">{t.heading}</h2>
        <div class="overflow-x-auto rounded-2xl border border-base-300">
          <table class="table">
            <thead class="bg-base-200 text-base-content/70">
              <tr>
                <th class="text-sm font-semibold">時間</th>
                <th class="text-sm font-semibold">礼拝</th>
                <th class="text-sm font-semibold">言語</th>
                <th class="text-sm font-semibold">通訳</th>
              </tr>
            </thead>
            <tbody>
              {t.rows.map((r) => (
                <tr class="hover:bg-base-200/50">
                  <th class="whitespace-nowrap font-semibold text-primary">{r.time}</th>
                  <td>{r.name}</td>
                  <td>{r.lang}</td>
                  <td>{r.interp}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </div>
</section>
