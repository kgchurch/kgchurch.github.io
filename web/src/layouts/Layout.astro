---
import { SEO } from "astro-seo";
import "~/styles/global.css";
import GA from '~/components/GA.astro';

import AppHeaderJa from '~/components/ja/AppHeader.astro';
import AppHeaderKo from '~/components/ko/AppHeader.astro';
import AppFooterJa from '~/components/ja/AppFooter.astro';
import AppFooterKo from '~/components/ko/AppFooter.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const isJa = Astro.currentLocale === "ja";
const AppHeader = isJa ? AppHeaderJa : AppHeaderKo;
const AppFooter = isJa ? AppFooterJa : AppFooterKo;
const lang = Astro.currentLocale || "ko";
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- Pretendard (SIL Open Font License 1.1) — 한국어/일본어/영문 고딕 -->
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-jp-dynamic-subset.min.css"
		/>
		<SEO title={title} description={description} />
		<GA />
	</head>
	<body class="bg-base-100 text-base-content min-h-screen flex flex-col">
		<AppHeader />
		<main class="flex-1">
			<slot />
		</main>
		<AppFooter />
	</body>
</html>
